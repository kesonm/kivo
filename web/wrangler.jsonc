{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kivo",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "kivo.iptnet.xyz", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/healthz"]
  },
  "vars": { "ORIGIN_URL": "https://origin-kivo.iptnet.xyz" },
  "observability": { "enabled": false }
}
