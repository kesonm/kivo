# The pre-existing server image is used so deployment does not require a new
# Docker Hub base pull. Codex itself is pinned independently.
FROM node:22-bookworm-slim
ARG DEBIAN_MIRROR=http://deb.debian.org
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git python3 bash tini \
    && rm -rf /var/lib/apt/lists/*
ARG NPM_REGISTRY=https://registry.npmjs.org
RUN npm install --global --ignore-scripts --registry "$NPM_REGISTRY" @openai/codex@0.167.0 \
    && npm cache clean --force
ENV HOME=/home/node CODEX_HOME=/codex-home
RUN mkdir -p /workspace /codex-home && chown node:node /workspace /codex-home
WORKDIR /workspace
USER 1000:1000
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["codex", "--version"]
