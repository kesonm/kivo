PUBLIC_ORIGIN=https://kivo.example.com
COOKIE_SECURE=true
ADMIN_USERNAME=admin
CODEX_MODEL=gpt-6.1-sol
# Optional positive integer. Leave unset/blank to use the provider's output limit.
# MAX_OUTPUT_TOKENS=
# Summarize ordinary/project conversation titles after each successful turn.
# Uses the owner's key/model and records a separate title-summary usage entry.
AUTO_THREAD_TITLES=true
RUN_TIMEOUT_MS=600000
MAX_CONCURRENT_RUNS=2
# Record routing decisions first. Enable enforce only after reviewing the
# owner-scoped decisions and completing the migration/acceptance checks.
WORK_ROUTING_MODE=shadow
WORK_CONTEXT_BYTES=393216
# Optional verified per-model limits. Unknown models keep the byte ceiling.
WORK_MODEL_BUDGETS={}
# Optional: the explicit Docker bridge gateway IP used by your reverse proxy.
# TRUST_PROXY_IPS=172.19.0.1
# Optional only when the separate outbound proxy has been configured:
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://openai-proxy:18082
# NO_PROXY=localhost,127.0.0.1,::1,gateway
