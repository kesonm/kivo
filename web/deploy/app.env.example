PUBLIC_ORIGIN=https://kivo.example.com
COOKIE_SECURE=true
ADMIN_USERNAME=admin
CODEX_MODEL=gpt-6.1-sol
MAX_OUTPUT_TOKENS=4096
RUN_TIMEOUT_MS=600000
MAX_CONCURRENT_RUNS=2
# Optional: the explicit Docker bridge gateway IP used by your reverse proxy.
# TRUST_PROXY_IPS=172.19.0.1
# Optional only when the separate outbound proxy has been configured:
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://openai-proxy:18082
# NO_PROXY=localhost,127.0.0.1,::1,gateway
